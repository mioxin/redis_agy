      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "editorMode": "code",
          "expr": "(sum(rate(courier_cache_hits_total[5m])) / clamp_min(sum(rate(courier_cache_hits_total[5m])) + sum(rate(courier_cache_misses_total[5m])), 0.0001)) * 100",
          "legendFormat": "Hit Ratio",
          "range": true,
          "refId": "A"
